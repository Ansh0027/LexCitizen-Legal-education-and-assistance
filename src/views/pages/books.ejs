            <article class="book-card">
              <span class="book-number" aria-hidden="true">03</span>
              <div>
                <p class="section-eyebrow">Criminal law · Comparative study</p>
                <h3>Interplay between the Indian Penal Code and the Bharatiya Nyaya Sanhita</h3>
                <p class="book-author">Special focus on newly created and deleted offences</p>
              </div>
              <p class="book-placeholder">Open the supplied PDF in a new tab or download it to your device.</p>
              <div class="book-actions">
