        <section class="books-shelf" aria-labelledby="books-shelf-title">
          <div class="section-heading">
            <div>
              <p class="section-eyebrow">Reading shelf</p>
              <h2 id="books-shelf-title">Books and resources</h2>
            </div>
            <span class="books-count">4 PDFs available</span>
          </div>

          <div class="books-grid">
            <article class="book-card">
              <span class="book-number" aria-hidden="true">01</span>
              <div>
                <p class="section-eyebrow">Indian law · Historic code</p>
                <h3>Indian Penal Code</h3>
                <p class="book-author">Act No. 45 of 1860</p>
              </div>
              <p class="book-placeholder">Open the supplied PDF in a new tab or download it to your device.</p>
              <div class="book-actions">
                <a class="book-pdf-button" href="books/indian-penal-code.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open Indian Penal Code PDF in a new tab">Open PDF <span aria-hidden="true">↗</span></a>
                <a class="book-download-link" href="books/indian-penal-code.pdf" download aria-label="Download Indian Penal Code PDF">Download PDF</a>
              </div>
              <div class="book-resource">
                <p class="section-eyebrow">Related PDF</p>
                <h4>Transition from IPC to Bharatiya Nyaya Sanhita: A Critical Analysis</h4>
                <div class="book-actions">
                  <a class="book-pdf-button" href="books/TransitionfromIPCtoBNSConcise.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open Transition from IPC to Bharatiya Nyaya Sanhita PDF in a new tab">Open PDF <span aria-hidden="true">↗</span></a>
                  <a class="book-download-link" href="books/TransitionfromIPCtoBNSConcise.pdf" download aria-label="Download Transition from IPC to Bharatiya Nyaya Sanhita PDF">Download PDF</a>
                </div>
              </div>
            </article>

            <article class="book-card">
              <span class="book-number" aria-hidden="true">02</span>
              <div>
                <p class="section-eyebrow">Criminal procedure · 2023</p>
                <h3>Bharatiya_Nagarik_Suraksha_Sanhita,_2023.pdf</h3>
                <p class="book-author">Act consolidating and amending criminal procedure law</p>
              </div>
              <p class="book-placeholder">Open the supplied PDF in a new tab or download it to your device.</p>
              <div class="book-actions">
                <a class="book-pdf-button" href="books/Bharatiya_Nagarik_Suraksha_Sanhita,_2023.pdf" target="_blank" rel="noopener noreferrer" aria-label="Open Bharatiya Nagarik Suraksha Sanhita 2023 PDF in a new tab">Open PDF <span aria-hidden="true">↗</span></a>
